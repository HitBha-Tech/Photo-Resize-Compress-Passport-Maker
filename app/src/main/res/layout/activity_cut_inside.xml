<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.cut.CutInsideImageActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/cut_inside_image"
        app:titleTextColor="?attr/colorOnSurface"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:navigationIcon="@drawable/ic_undo"
        app:navigationContentDescription="@string/cd_undo"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_image"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:elevation="0dp"
            app:cornerRadius="@dimen/pill_corner"
            android:textColor="?attr/colorOnPrimary"
            android:text="@string/select" />

        <ImageButton
            android:id="@+id/btn_undo"
            style="?attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:padding="2dp"
            android:src="@drawable/ic_undo_theme"
            android:background="@drawable/pill_bg_theme"
            android:enabled="false"
            android:contentDescription="@string/cd_undo" />

        <ImageButton
            android:id="@id/btn_redo"
            style="?attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:padding="2dp"
            android:src="@drawable/ic_redo_theme"
            android:background="@drawable/pill_bg_theme"
            android:enabled="false"
            android:contentDescription="@string/cd_redo" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/mode_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cut_mode"
            android:textSize="16sp"
            android:textColor="@color/gray" />

        <Spinner
            android:id="@+id/cut_mode_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/cut_modes"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cut"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/cut"
            app:cornerRadius="@dimen/pill_corner" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:text="@string/save"
            app:cornerRadius="@dimen/pill_corner" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/share"
            app:cornerRadius="@dimen/pill_corner" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="@color/light_gray"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mode_selector">

        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.hitbha.photo.ui.cut.CutRectangleOverlayView
            android:id="@+id/rectangle_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
