<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.editor.EditorActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/image_editor"
        app:titleTextColor="?attr/colorOnSurface"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:navigationIcon="@drawable/ic_undo"
        app:navigationContentDescription="@string/cd_undo"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_image"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:elevation="0dp"
            app:cornerRadius="@dimen/pill_corner"
            android:textColor="?attr/colorOnPrimary"
            android:text="@string/select" />

        <ImageButton
            android:id="@+id/btn_undo"
            style="?attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:padding="2dp"
            android:src="@drawable/ic_undo_theme"
            android:background="@drawable/pill_bg_theme"
            android:enabled="false"
            android:contentDescription="@string/cd_undo" />

        <ImageButton
            android:id="@+id/btn_redo"
            style="?attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:padding="2dp"
            android:src="@drawable/ic_redo_theme"
            android:background="@drawable/pill_bg_theme"
            android:enabled="false"
            android:contentDescription="@string/cd_redo" />

    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/light_gray"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.hitbha.photo.ui.editor.CropOverlayView
            android:id="@+id/crop_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.hitbha.photo.ui.editor.EraseOverlayView
            android:id="@+id/erase_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <com.hitbha.photo.ui.editor.StampOverlayView
            android:id="@+id/stamp_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.hitbha.photo.ui.editor.FullPageOverlayView
            android:id="@+id/fullpage_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_add_stamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/add_sign_or_page"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:fabSize="normal"
        app:backgroundTint="?attr/colorSurface"
        app:tint="?attr/colorOnSurface"
        app:srcCompat="@drawable/ic_layers" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_brush_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:contentDescription="@string/brush_size"
        app:layout_constraintBottom_toTopOf="@id/erase_chip_group"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="48dp"
        app:fabSize="mini"
        app:backgroundTint="?attr/colorSurface"
        app:tint="?attr/colorOnSurface"
        app:srcCompat="@drawable/ic_edit" />

    <HorizontalScrollView
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_crop"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/crop"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                app:cornerRadius="@dimen/pill_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_remove_bg"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/remove_bg"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                app:cornerRadius="@dimen/pill_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_final_touches"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/final_touches"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                app:cornerRadius="@dimen/pill_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_page"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/page"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                android:enabled="false"
                app:cornerRadius="@dimen/pill_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resize"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/resize"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                app:cornerRadius="@dimen/pill_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_compress"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/compress"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                app:cornerRadius="@dimen/pill_corner" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_adjust"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/adjust"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                app:cornerRadius="@dimen/pill_corner" />
				
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rotate"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/rotate"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginHorizontal="4dp"
                app:cornerRadius="@dimen/pill_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/save"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="8dp"
                app:cornerRadius="@dimen/pill_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/share"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="4dp"
                app:cornerRadius="@dimen/pill_corner" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/crop_chip_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="0dp"
        app:singleSelection="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="56dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_cancel_crop"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            app:chipCornerRadius="@dimen/chip_corner" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_apply_crop"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply"
            app:chipCornerRadius="@dimen/chip_corner" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/erase_chip_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="0dp"
        app:singleSelection="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="56dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_cancel_erase"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            app:chipCornerRadius="@dimen/chip_corner" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_apply_erase"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"
            app:chipCornerRadius="@dimen/chip_corner" />
    </com.google.android.material.chip.ChipGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
